<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261017120000-1-remove-pay-recipient-fields" author="paynet">
        <sql>
            DELETE FROM recipient_field_value
            WHERE recipient_field_id IN (
                SELECT id FROM recipient_field WHERE method = 'PAY'
            );

            DELETE FROM recipient_field WHERE method = 'PAY';
        </sql>
        <dropColumn tableName="recipient_field" columnName="method"/>
    </changeSet>
</databaseChangeLog>
