<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261008123000-1-add-payment-idempotency-columns" author="paylite">
        <addColumn tableName="payment">
            <column name="check_id" type="varchar(255)"/>
            <column name="paynet_payment_id" type="varchar(255)"/>
            <column name="idempotency_key" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20261008123000-2-add-payment-idempotency-unique" author="paylite">
        <addUniqueConstraint
            tableName="payment"
            columnNames="idempotency_key"
            constraintName="ux_payment__idempotency_key"/>
    </changeSet>
</databaseChangeLog>
