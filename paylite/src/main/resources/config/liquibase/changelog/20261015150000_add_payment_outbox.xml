<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261015150000-1" author="paylite">
        <createTable tableName="payment_outbox_event">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="${datetimeType}"/>
            <column name="publish_attempts" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="varchar(1000)"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="payment_outbox_event"
            baseColumnNames="payment_id"
            constraintName="fk_payment_outbox_event__payment_id"
            referencedTableName="payment"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex tableName="payment_outbox_event" indexName="idx_payment_outbox__unpublished">
            <column name="published_at"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
